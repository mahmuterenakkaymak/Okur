    {
      "id": "file:app/numbers.py",
      "type": "file",
      "name": "numbers.py",
      "filePath": "app/numbers.py",
      "summary": "Türkçe fiş sayılarını (\"1.046,40\", \"1.046,40 TL\", \"%20\", OCR kaymaları) yapılandırıcı ve doğrulayıcının ortak tek ayrıştırıcısıyla float'a çevirir; sayı olmayan değer sessiz 0.0 yerine her zaman None döner.",
      "tags": ["utility", "parser", "localization", "validation"],
      "complexity": "moderate",
      "languageNotes": "Son ayıraç ondalık, önceki noktalar binlik grubu kabul edilir; NFKC normalizasyonu ve zero-width karakter temizliği OCR varyantlarını (nbSP, tam genişlik rakam) tek biçime indirger."
    },
    {
      "id": "function:app/numbers.py:parse_number",
