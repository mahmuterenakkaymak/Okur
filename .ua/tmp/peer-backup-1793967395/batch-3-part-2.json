      "filePath": "app/routes_jobs.py",
      "lineRange": [140, 155],
      "summary": "Pillow'un piksel çözümlemesini zorlayarak yalnızca gerçekten çözülebilir görselleri kuyruğa sokar; bozuk ya da kılık değiştirmiş dosya bir kuyruk hakkı ve bir OCR koşunu harcamadan kapıda reddedilir.",
      "tags": ["validasyon", "gorsel", "guvenlik"],
      "complexity": "simple"
    },
