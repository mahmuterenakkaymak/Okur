    {
      "id": "file:app/routes_jobs.py",
      "type": "file",
      "name": "routes_jobs.py",
      "filePath": "app/routes_jobs.py",
      "summary": "/v1/jobs: fiş yüklemenin kuyruğa alınması, client_ref idempotency'si ve sözleşme v1 zarf görünümleri; POST bir kabul işlemidir, hesap değil — görsel diske iner, satır queued kalır ve 202 döner.",
      "tags": ["api-handler", "kuyruk", "sozlesme", "yukleme", "idempotency"],
      "complexity": "complex",
      "languageNotes": "T67 sırası: önce baytlar, sonra satır — işçinin iddia edebileceği her queued satırının diskte görüntüsü vardır. Idempotency yarışması sqlite3.IntegrityError ile yakalanıp yazılan dosya silinerek mevcut işe bağlanır."
    },
    {
      "id": "function:app/routes_jobs.py:create_job",
      "type": "function",
      "name": "create_job",
      "filePath": "app/routes_jobs.py",
      "lineRange": [34, 89],
      "summary": "Yüklenen fişi boyut ve çözünürlük açısından doğrular, EXIF'i düşürüp data/images/<job_id>.jpg olarak yazar ve işi kuyruğa alır; aynı client_ref ile gelen yeniden denemede mevcut işi 200 ile döner, böylece ikinci bir OCR koşusu doğmaz.",
      "tags": ["api-handler", "kuyruk", "yukleme", "idempotency"],
      "complexity": "complex"
    },
    {
      "id": "function:app/routes_jobs.py:list_jobs",
      "type": "function",
      "name": "list_jobs",
      "filePath": "app/routes_jobs.py",
      "lineRange": [93, 112],
      "summary": "Durum, çalışan ve since filtreleriyle sözleşme zarflarını listeler; mine=true çağrıyı yalnızca anahtarın kendi işlerine daraltır.",
      "tags": ["api-handler", "liste", "sozlesme", "filtreleme"],
      "complexity": "simple"
    },
    {
      "id": "function:app/routes_jobs.py:get_job",
      "type": "function",
      "name": "get_job",
      "filePath": "app/routes_jobs.py",
      "lineRange": [116, 124],
      "summary": "Tek işin sözleşme v1 zarfını döndürür; satır yoksa 404.",
      "tags": ["api-handler", "detay", "sozlesme"],
      "complexity": "simple"
    },
    {
      "id": "function:app/routes_jobs.py:too_large_message",
      "type": "function",
      "name": "too_large_message",
      "filePath": "app/routes_jobs.py",
      "lineRange": [132, 137],
      "summary": "Yükleme sınırı aşımının çalışanın telefonunda birebir görünecek Türkçe metnini üretir; main'in yük sınırı middleware'i de aynı metni kullanır.",
      "tags": ["mesaj", "validasyon", "turkce", "yardimci"],
      "complexity": "simple"
    },
    {
